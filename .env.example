# --- Payload ---
# Pooled Neon connection string (Phase 1) / Azure Flexible Server (Phase 7).
# Azure additionally requires ?sslmode=require
DATABASE_URI=postgres://user:password@host/dbname?sslmode=require
# Any long random string. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# --- Media (Phase 4) ---
# From the Vercel dashboard: Storage > Blob > connect. Without this, uploads
# fall back to local disk, which is NOT writable on Vercel.
BLOB_READ_WRITE_TOKEN=

# --- Email (Phase 3) ---
# Real production SMTP credentials. There is deliberately no fallback: with
# these unset the app refuses to boot in production rather than silently
# discarding career, contact and mailing-list notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FULL_NAME="Anjali Elastomer"

# Notification destinations (defaults shown).
CAREERS_EMAIL=careers@anjalielastomer.com
CONTACT_EMAIL=info@anjalielastomer.com

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=https://anjalielastomer.com
# Payload REST base. Leave unset to use the app's own /api (recommended).
NEXT_PUBLIC_API_URL=
